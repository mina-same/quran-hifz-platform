{
  "expo": {
    "name": "منصة تحفيظ القرآن",
    "slug": "quran-hifz-mobile",
    "scheme": "quran-hifz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "نحتاج إذن الميكروفون لتسجيل تلاوة الواجب وإرساله للمعلم"
      },
      "bundleIdentifier": "com.mina-samy.quran-hifz-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.minasamy.quranhifzmobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "نحتاج إذن الميكروفون لتسجيل تلاوة الواجب وإرساله للمعلم"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1B5E20"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم Face ID لتسجيل دخولك بأمان وسرعة"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E20"
        }
      ]
    ]
  }
}
